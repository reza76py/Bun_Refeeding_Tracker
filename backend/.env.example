# Copy to backend/.env for local (non-Docker) development.
# For a zero-setup local run, use the SQLite engine and skip the MySQL vars.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# DJANGO_SECURE_COOKIES=false   # force off for local HTTP; defaults to (not DEBUG)

# --- Database ---
# DB_ENGINE=sqlite            # uncomment for a no-MySQL local run
DB_ENGINE=mysql
DB_NAME=shelf_tracker
DB_USER=shelf
DB_PASSWORD=shelfpass
DB_HOST=127.0.0.1
DB_PORT=3306
