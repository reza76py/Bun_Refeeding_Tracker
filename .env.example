# Copy to .env (same folder as docker-compose.yml) before `docker compose up`.

DB_NAME=shelf_tracker
DB_USER=shelf
DB_PASSWORD=shelfpass
DB_ROOT_PASSWORD=rootpass

DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Seeded demo user created on first start.
SEED_USER=demo
SEED_PASSWORD=demo12345
